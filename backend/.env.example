# 复制为同目录的 .env，再填入完整 API Key（不是 API Key ID）。
# 不要将真实密钥提交到 Git 或粘贴到聊天中。
# LLM_PROVIDER 支持 deepseek / zhipu；默认使用 DeepSeek。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
MODEL_NAME=deepseek-v4-flash
MODEL_TIMEOUT_SECONDS=300

# Day24 宏观发布数据。
# BLS Public Data API v1 不需要 API Key。
FRED_API_KEY=
TRADING_ECONOMICS_API_KEY=

# 服务器 PostgreSQL 连接地址；云数据库要求 SSL 时在末尾添加 ?sslmode=require。
# 配置后，SEC 原文、索引状态、chunk 和向量会写入 PostgreSQL / pgvector。
STOCK_AGENT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# 如果切回智谱，改为 LLM_PROVIDER=zhipu 并设置：
# ZHIPU_API_KEY=
